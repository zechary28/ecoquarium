[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/select_plant_button.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/ui/shop_icons/shop_button_normal.png" id="2_normal"]
[ext_resource type="Texture2D" path="res://assets/ui/shop_icons/coin.png" id="3_coin"]
[ext_resource type="FontFile" path="res://assets/PixeltaRegular-lxoDw.ttf" id="4_font"]

[node name="SelectPlantButton" type="HBoxContainer"]
custom_minimum_size = Vector2(190, 72)
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="IconButton" type="TextureButton" parent="."]
custom_minimum_size = Vector2(64, 64)
layout_mode = 2
texture_normal = ExtResource("2_normal")
texture_pressed = ExtResource("2_normal")
texture_hover = ExtResource("2_normal")
ignore_texture_size = true
stretch_mode = 5
toggle_mode = true

[node name="Icon" type="TextureRect" parent="IconButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 7.0
offset_right = -10.0
offset_bottom = -7.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="CostRow" type="HBoxContainer" parent="."]
layout_mode = 2
alignment = 1

[node name="Coin" type="TextureRect" parent="CostRow"]
custom_minimum_size = Vector2(24, 24)
layout_mode = 2
texture = ExtResource("3_coin")
expand_mode = 1
stretch_mode = 5

[node name="LabelPrice" type="Label" parent="CostRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.168627, 0.101961, 0.0705882, 1)
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 20

[connection signal="button_down" from="IconButton" to="." method="_on_icon_button_button_down"]
[connection signal="button_up" from="IconButton" to="." method="_on_icon_button_button_up"]
[connection signal="mouse_entered" from="IconButton" to="." method="_on_icon_button_mouse_entered"]
[connection signal="mouse_exited" from="IconButton" to="." method="_on_icon_button_mouse_exited"]
[connection signal="toggled" from="IconButton" to="." method="_on_icon_button_toggled"]
