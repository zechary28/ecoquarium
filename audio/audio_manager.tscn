[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://audio/audio_manager.gd" id="1_audio"]
[ext_resource type="AudioStream" path="res://assets/audio/music/ecoquarium_loop.wav" id="2_music"]
[ext_resource type="AudioStream" path="res://assets/audio/ui/click.wav" id="3_click"]
[ext_resource type="AudioStream" path="res://assets/audio/sfx/fish_place.ogg" id="4_fish"]
[ext_resource type="AudioStream" path="res://assets/audio/sfx/plant_place.ogg" id="5_plant"]
[ext_resource type="AudioStream" path="res://assets/audio/sfx/food_drop.ogg" id="6_food"]
[ext_resource type="AudioStream" path="res://assets/audio/ui/purchase_denied.ogg" id="7_error"]

[node name="AudioManager" type="Node"]
process_mode = 3
script = ExtResource("1_audio")
aquarium_music = ExtResource("2_music")
ui_hover_sfx = ExtResource("3_click")
ui_click_sfx = ExtResource("3_click")
fish_placed_sfx = ExtResource("4_fish")
plant_placed_sfx = ExtResource("5_plant")
food_dropped_sfx = ExtResource("6_food")
light_changed_sfx = ExtResource("3_click")
purchase_denied_sfx = ExtResource("7_error")

[node name="MusicPlayer" type="AudioStreamPlayer" parent="."]
stream = ExtResource("2_music")
volume_db = 8.0
autoplay = true
bus = &"Music"

[node name="AmbiencePlayer" type="AudioStreamPlayer" parent="."]
bus = &"Ambience"
