[gd_scene format=3 uid="uid://em8ccttxirno"]

[ext_resource type="Shader" uid="uid://b4goa5hgton8p" path="res://dither_transition.gdshader" id="1_0wykx"]

[sub_resource type="GDScript" id="GDScript_rqutq"]
script/source = "extends CanvasLayer

@onready var rect: ColorRect = $ColorRect
var shader_mat: ShaderMaterial

func _ready() -> void:
	layer = 128
	if rect:
		rect.visible = true
		rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		if rect.material is ShaderMaterial:
			shader_mat = rect.material
			shader_mat.set_shader_parameter(\"progress\", 0.0)
		else:
			push_error(\"SceneTransition: ColorRect missing ShaderMaterial!\")

func change_scene(target_scene_path: String, duration: float = 0.8) -> void:
	if not shader_mat:
		get_tree().change_scene_to_file(target_scene_path)
		return

	rect.mouse_filter = Control.MOUSE_FILTER_STOP
	
	# 1. Dither out to solid color
	var dissolve: Tween = create_tween()
	dissolve.tween_property(shader_mat, \"shader_parameter/progress\", 1.0, duration)\\
		.set_trans(Tween.TRANS_LINEAR)
	await dissolve.finished
	
	# 2. Swap scenes
	var err: Error = get_tree().change_scene_to_file(target_scene_path)
	if err != OK:
		push_error(\"SceneTransition: Failed to open %s\" % target_scene_path)
		shader_mat.set_shader_parameter(\"progress\", 0.0)
		rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
		return
	
	await get_tree().process_frame
	await get_tree().process_frame
	
	# 3. Dither back into new scene
	var reveal: Tween = create_tween()
	reveal.tween_property(shader_mat, \"shader_parameter/progress\", 0.0, duration)\\
		.set_trans(Tween.TRANS_LINEAR)
	await reveal.finished
	
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_a46j4"]
shader = ExtResource("1_0wykx")
shader_parameter/progress = 0.0
shader_parameter/wipe_color = Color(0, 0, 0, 1)
shader_parameter/pixel_size = 2.0

